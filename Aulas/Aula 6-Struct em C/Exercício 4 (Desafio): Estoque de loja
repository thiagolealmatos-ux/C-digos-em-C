#include <stdio.h>

typedef struct {
    char nome[50];
    float preco;
    int quantidade;
    
} Produto;

int main()
{
   int n;
   
   int maior = 0;
    
    printf("Quantos Produtos:");
   scanf("%d", &n);
   
   Produto produto[n];
  float valor_em_estoque = 0;
  float total_geral = 0;
 char NomeMaiorvalor[50];
   
   for(int i = 0; i < n; i++){
       printf("Produto %d|", i + 1);
       printf("Nome do Produto: ");
       scanf("%s", produto[i].nome);
       printf("Qual e o preço desse produto: ");
       scanf("%f", &produto[i].preco);
       printf("Quantos desse produto: ");
       scanf("%d", &produto[i].quantidade);
       
   }
  
  printf("\n---------------------RESUMO DA SUA COMPRA--------------------\n");
  printf("%-15s %-12s %-8s %-12s\n", "Produto", "Preco", "Qtd", "Total");
  printf("---------------------------------------------------------------\n");

   for(int i = 0; i < n; i++){
      
      float valor_em_estoque = produto[i].preco * produto[i].quantidade;
      total_geral += valor_em_estoque;
      
      if(valor_em_estoque > produto[maior].preco * produto[maior].quantidade) {
           maior = i;
      }
       printf("%-15s R$ %-9.2f %-8d R$ %.2f\n",
    produto[i].nome,
    produto[i].preco,
    produto[i].quantidade,
     valor_em_estoque);
    }
      
       printf("---------------------------------------------------------------\n");
    printf("Total geral: R$ %.2f\n", total_geral);

    printf("Maior estoque: %s (R$ %.2f)\n",
           produto[maior].nome,
           produto[maior].preco * produto[maior].quantidade);
  
    return 0;
}