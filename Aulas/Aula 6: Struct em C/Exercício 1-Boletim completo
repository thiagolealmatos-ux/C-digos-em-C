#include <stdio.h>

typedef struct {
    
     int nota;
    char nome[50];
    
} Aluno;

int main()
{
   int n;
   float media = 0;
   int maior = 0;
   int total = 0;
   int menor = 0;
   int acimamedia = 0;
   
   printf("Digite quantos alunos são: ");
   scanf("%d", &n);
   
   Aluno a[n];
   
   for(int i = 0; i < n; i++){
       
       printf("Aluno %d|", i + 1);
       printf("Digite o nome do aluno: ");
       scanf("%s", a[i].nome);
       printf("Digite a nota do aluno: ");
       scanf("%d", &a[i].nota);
  
   total += a[i].nota;
  
   }
    media = (float) total / n;
   
    for(int i = 0; i < n; i++){ 
        
        printf("\n----------------------------------------\n");
        printf("Nome do aluno: %s", a[i].nome);
        printf("\nNota do aluno: %d", a[i].nota);
       
        
        if(a[i].nota > a[maior].nota){
            maior = i;
            
        }
        if(a[i].nota < a[menor].nota){
            menor = i;
        }
           
        
            if(a[i].nota > media){
                acimamedia ++;
               
            }
    }
    printf("\n----------------------------------------\n");
    printf("Aluno com a maior nota: %s", a[maior].nome);
     printf("\nAluno com a menor nota: %s", a[menor].nome);
      printf("\nMedia da turma: %.2f", media);
     printf("\nQuantidade de alunos acima da media: %d", acimamedia);
        
        
    return 0;
}
