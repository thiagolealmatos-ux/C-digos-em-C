#include <stdio.h>

int somaDigitos(int n){
    
    if(n == 0){
        return 0;
    }
    return (n % 10) + somaDigitos(n / 10);
}
int main()
{
    int n;
    
    printf("Digite 4 Números Aleatórios: ");
    scanf("%d", &n);
    
    somaDigitos(n);
    
    printf("Soma dos Números Digitados: %d", somaDigitos(n));
    

    return 0;
}
