#include <stdio.h>

int maior(int v[], int n){
    
    if(n == 1){
        return v[0];
    }
    
     int M = maior(v + 1, n - 1);
     
    if(v[0] > M){
        return v[0];
    }
    else{
        return M;
    }
}
int main()
{
    int v[] = {7, 2, 9, 4, 1}, MaiorNúmero, n = 5;
    
    printf("Vetor: ");
  for(int i = 0; i < n; i++){
      printf("%d", v[i]);
  }
  
    MaiorNúmero = maior(v, n);
    
    printf("\nMaior Número do vetor: %d", MaiorNúmero);
    return 0;
}