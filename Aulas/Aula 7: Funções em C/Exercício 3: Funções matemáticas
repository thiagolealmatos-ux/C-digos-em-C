#include <stdio.h>

int potencia(int base, int exp) {
    
    int resultado = 1;

    for (int i = 0; i < exp; i++) {
        resultado = resultado * base;
    }

    return resultado;
}

int fatorial(int n) {
    
    int resultado = 1;

    for (int i = 1; i <= n; i++) {
        resultado = resultado * i;
    }

    return resultado;
}

int ehPrimo(int n) {
    
    if (n < 2) {
        return 0;
    }

    for (int i = 2; i < n; i++) {
        if (n % i == 0) {
            return 0;
        }
    }

    return 1;
}

int main() {
   
    int n;

    printf("Digite um Número: ");
    scanf("%d", &n);

    printf("Potência elevado a 2: %d\n", potencia(n, 2));
    printf("Fatorial: %d\n", fatorial(n));

    if (ehPrimo(n) == 1) {
        printf("É primo\n");
    } else {
        printf("Não é primo\n");
    }

    return 0;
}