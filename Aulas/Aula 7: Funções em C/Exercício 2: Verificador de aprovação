#include <stdio.h>

typedef struct{
    
    char nome[50];
    float n1, n2, n3;
    
} Aluno;

float calcularMedia(float n1, float n2, float n3){
    
    return(n1 + n2 + n3) / 3;
}

char definirConceito(float media){
    
    if(media >= 9){
        return 'A';
    }
    if(media >= 7){
        return 'B';
    }
    if(media >= 5){
        return 'C';
    }
    else{
        return 'D';
    }
}
    void imprimirSituacao(char nome[], float media, char conceito){
    
    printf("%-15s Média: %.2f   Conceito: %c\n", nome, media, conceito);
    
    
}
int main()
{
    Aluno aluno[3];
    
    char conceito;
    float media;
    
    for(int i = 0; i < 3; i++){
        printf("%d°| Aluno: ", i + 1);
        scanf("%s", aluno[i].nome);
        
        printf("Nota 1: ");
        scanf("%f", &aluno[i].n1);
        printf("Nota 2: ");
        scanf("%f", &aluno[i].n2);
        printf("Nota 3: ");
        scanf("%f", &aluno[i].n3);
        
}
printf("--------RESULTADO--------\n");

for(int i = 0; i < 3; i++){
     
    media = calcularMedia(aluno[i].n1, aluno[i].n2, aluno[i].n3);

    conceito = definirConceito(media);

    imprimirSituacao(aluno[i].nome, media, conceito);
}

    return 0;
}