#include <stdio.h>

int somaVetor(int v[], int n){
    
    if(n == 0){
        return 0;
    }
    return v[0] + somaVetor(v + 1, n - 1);
}
int main()
{
   int v[4];
   
    for(int i = 0; i < 4; i++){
        printf("Digite o %d° Número: ", i + 1);
        scanf("%d", &v[i]);
    }
    printf("\nSeu Vetor: {");
    
   for(int i = 0; i < 4; i++){
       printf("%d,", v[i]);
   }
printf("}");

printf("\nSoma do seu vetor: %d", somaVetor(v, 4));

    return 0;
}
