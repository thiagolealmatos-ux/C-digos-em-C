#include <stdio.h>

typedef struct {
    char nome[50];
    int pontos;
} Jogador;

int main()
{
   int quantidade, maior = 0, menor = 0;
   
    printf("Quantos Jogadores:");
   scanf("%d", &quantidade);
   
   Jogador jogador[quantidade];
  
   
   for(int i = 0; i < quantidade; i++){
       printf("Jogador %d|", i + 1);
       printf("Nome do Jogador: ");
       scanf("%s", jogador[i].nome);
       printf("Quantos pontos esse jogador fez: ");
       scanf("%d", &jogador[i].pontos);
   }
   printf("-------------RESUMO DA PARTIDA!-------------");
   for(int i = 0; i < quantidade; i++){
       printf("\nNome do seu jogador: %s", jogador[i].nome);
       printf("\nPontos do seu jogador: %d", jogador[i].pontos);
   
  
   
   if(jogador[i].pontos > jogador[maior].pontos){
       
      maior = i;
 
   }
   if(jogador[i].pontos < jogador[menor].pontos){
       menor = i;
   }
    }

  printf("\n-------------MVP DA PARTIDA-------------");
  printf("\nJogador com mais pontos: %s", jogador[maior].nome);
  printf("\nPontos: %d", jogador[maior].pontos);
  printf("\n---------------------------------------------\n");
  printf("Jogador com menos pontos: %s", jogador[menor].nome);
  printf("\nPontos: %d", jogador[menor].pontos);
   
    return 0;
}