#include <stdio.h>

typedef struct {
    float nota1, nota2, nota3;
    char nome[50];
    float media;
    float total;
   
}Aluno;

Aluno calcularMedia(Aluno a){
    
    a.total = a.nota1 + a.nota2 + a.nota3;
    a.media = a.total / 3;
    
    return a;
}
char definirConceito(float media){
    
    if(media >= 9){
        return 'A';
    }
     if(media >= 7){
         return 'B';
     }
     if(media >= 5){
         
        return 'C';
     }
    else{
        return 'D';
    }
    
}
void imprimirAluno(Aluno a){
    
